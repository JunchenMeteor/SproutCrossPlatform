<script lang="uts">
/**
 * 应用组合根：启动时构建 ThemeStore 并加载设备上的主题偏好。
 * 页面与组件通过注入/共享的 ThemeStore 消费主题，不硬编码颜色；
 * 录音、文件、权限、登录等平台能力经 platform/ adapter 注入。
 */
import { getThemeStore, initAppContext } from "./features/AppContext";

export default {
  onLaunch: function () {
    initAppContext();
    console.log("onLaunch theme=" + getThemeStore().getTheme().surface.page);
  }
};
</script>

<style>
/*
 * uvue 仅支持类选择器，不使用 page 选择器。各页面根节点通过
 * ThemeStore 当前主题绑定背景与文字色，启动期无全局硬编码底色。
 */
</style>
