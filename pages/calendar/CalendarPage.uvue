<template>
  <view class="page" :style="pageStyle">
    <view class="head">
      <text class="kicker" :style="kickerStyle">打卡日历</text>
      <text class="title" :style="titleStyle">{{ monthKey }}</text>
    </view>
    <view class="calendar-card" :style="cardStyle">
      <CalendarGrid
        :weeks="weeks"
        :theme="theme"
        @select="onSelect"
      />
    </view>
    <view class="legend">
      <view class="legend-item">
        <view class="dot dot-done" :style="doneDotStyle" />
        <text :style="legendStyle">已完成</text>
      </view>
      <view class="legend-item">
        <view class="dot dot-makeup" :style="makeupDotStyle" />
        <text :style="legendStyle">补卡</text>
      </view>
      <view class="legend-item">
        <view class="dot dot-today" :style="todayDotStyle" />
        <text :style="legendStyle">今天</text>
      </view>
    </view>
    <text v-if="pendingCount > 0" :style="hintStyle">
      {{ pendingCount }} 条本地记录待联网确认；连续天数与累计由服务器确认后显示
    </text>
    <text v-else :style="hintStyle">
      连续天数与累计由服务器确认后显示；当前为本机演示数据
    </text>
  </view>
</template>

<script lang="uts">
/**
 * 日历页（tab）：网格由 CalendarGrid 渲染，完成/补卡/今天为图形+文字标识。
 * 服务端日历数据未联调前，只展示本机待同步事实与今天；连续天数/累计天数
 * 不在客户端自行计算（产品需求第5节，服务端权威）。
 */
import CalendarGrid from "../../components/CalendarGrid.uvue";
import { getThemeStore, localDevAccountId } from "../../features/AppContext";
import { todayTargetDate } from "../../features/BusinessDate";
import { buildMonthWeeks } from "../../features/CalendarView";
import { CalendarCellView } from "../../features/FeatureTypes";
import {
  getStorageValue,
  setStorageValue,
} from "../../platform/ThemeEnvAdapter";
import { SyncQueue } from "../../storage/SyncQueue";
import { ResolvedTheme } from "../../theme/ThemeTypes";

export default {
  components: { CalendarGrid },
  data() {
    return {
      theme: getThemeStore().getTheme() as ResolvedTheme | null,
      monthKey: "",
      weeks: [] as CalendarCellView[][],
      selected: null as string | null,
      pendingCount: 0,
    };
  },
  onShow() {
    this.theme = getThemeStore().getTheme();
    const today = todayTargetDate();
    this.monthKey = today.substring(0, 7);
    const queue = new SyncQueue(localDevAccountId,
        (key: string): string | null => getStorageValue(key),
        (key: string, value: string): void => setStorageValue(key, value));
    queue.load();
    const pendingDates: string[] = [];
    for (const checkIn of queue.listPendingCheckIns()) {
      pendingDates.push(checkIn.targetDate);
    }
    this.pendingCount = queue.pendingCount();
    this.weeks = buildMonthWeeks(this.monthKey, today, pendingDates, [],
      this.selected);
  },
  computed: {
    pageStyle(): string {
      const t = this.theme;
      return t == null ? "" : "background-color:" + t.surface.page + ";";
    },
    titleStyle(): string {
      const t = this.theme;
      return t == null ? "" : "color:" + t.text.primary + ";";
    },
    legendStyle(): string {
      const t = this.theme;
      return t == null ? "" : "color:" + t.text.secondary + ";font-size:14px;";
    },
    kickerStyle(): string {
      const t = this.theme;
      return t == null ? "" : "color:" + t.text.secondary +
          ";font-size:12px;letter-spacing:0.1em;";
    },
    cardStyle(): string {
      const t = this.theme;
      return t == null ? "" : "background-color:" + t.surface.card +
          ";border-color:" + t.border + ";";
    },
    doneDotStyle(): string {
      const t = this.theme;
      return t == null ? "" : "background-color:" + t.status.success.icon + ";";
    },
    makeupDotStyle(): string {
      const t = this.theme;
      return t == null ? "" : "background-color:" + t.button.primaryBg + ";";
    },
    todayDotStyle(): string {
      const t = this.theme;
      return t == null ? "" : "border-color:" + t.focusBorder + ";";
    },
    hintStyle(): string {
      const t = this.theme;
      return t == null ? "" : "color:" + t.text.tertiary + ";";
    },
  },
  methods: {
    onSelect(date: string): void {
      this.selected = date;
      const today = todayTargetDate();
      const queue = new SyncQueue(localDevAccountId,
        (key: string): string | null => getStorageValue(key),
        (key: string, value: string): void => setStorageValue(key, value));
      queue.load();
      const pendingDates: string[] = [];
      for (const checkIn of queue.listPendingCheckIns()) {
        pendingDates.push(checkIn.targetDate);
      }
      this.weeks = buildMonthWeeks(this.monthKey, today, pendingDates, [],
        this.selected);
    },
  },
};
</script>

<style>
.page {
  flex: 1;
  padding: 20px 18px;
}
.head {
  margin-bottom: 16px;
}
.kicker {
  font-size: 12px;
  margin-bottom: 6px;
}
.title {
  font-size: 28px;
}
.calendar-card {
  padding: 14px;
  border-radius: 22px;
  border-width: 1px;
  border-style: solid;
}
.legend {
  flex-direction: row;
  align-items: center;
  margin-top: 16px;
  margin-bottom: 8px;
}
.legend-item {
  flex-direction: row;
  align-items: center;
  margin-right: 18px;
}
.dot {
  width: 10px;
  height: 10px;
  border-radius: 5px;
  margin-right: 6px;
}
.dot-done {
  background-color: #4F9D69;
}
.dot-makeup {
  background-color: #87CEFA;
}
.dot-today {
  border-width: 2px;
  border-style: solid;
  background-color: transparent;
}
</style>
