<template>
  <view class="page" :style="pageStyle">
    <text class="title" :style="titleStyle">今天练什么？</text>
    <text class="eyebrow-note" :style="hintStyle">每天 10 分钟 · 只鼓励，不打分</text>

    <view class="hero-card" :style="cardStyle">
      <text class="hero-kicker" :style="eyebrowStyle">建议从这里开始</text>
      <text class="hero-title" :style="titleStyle">开始今天的练习</text>
      <text class="hero-body" :style="hintStyle">
        家长确认后，按下一课安排今天的练习。
      </text>
      <view class="hero-art"><image class="hero-tank" src="/static/tank-hero.png" mode="aspectFit" /></view>
      <AppButton
        label="学了新内容，开始"
        kind="primary"
        size="large"
        :theme="theme"
        @action="onNewLesson"
      />
    </view>

    <text class="section-label" :style="hintStyle">或者</text>

    <AppButton
      label="复习旧内容"
      kind="secondary"
      size="large"
      :theme="theme"
      @action="onReview"
    />
    <AppButton
      label="没上课或不清楚"
      kind="secondary"
      size="large"
      :theme="theme"
      @action="onUnknown"
    />

    <text v-if="pendingCount > 0" class="hint" :style="hintStyle">
      有 {{ pendingCount }} 条记录在这台设备上等待联网确认
    </text>
    <text class="hint" :style="hintStyle">演示内容：教材版本确认前使用原创小样</text>

    <AppDialog
      :open="confirmOpen"
      title="家长确认"
      confirmLabel="确认已学，开始练习"
      cancelLabel="再想想"
      :theme="theme"
      @confirm="onConfirmNewLesson"
      @cancel="onCancelConfirm"
    >
      <text :style="bodyStyle">
        只有家长确认孩子学了新内容，才会推进课程进度。确认后将按下一课安排今天的练习。
      </text>
    </AppDialog>
  </view>
</template>

<script lang="uts">
/**
 * 今日练习页（tab）：每日三入口。
 * “学了新内容”必须经家长确认对话框才进入新课练习，点击入口本身不推进
 * 已学范围（产品需求第2节）。待同步条数来自本机离线队列，仅作提示。
 * 教材未确认前使用原创演示 fixture，并在页面明示。
 */
import AppButton from "../../components/AppButton.uvue";
import AppDialog from "../../components/AppDialog.uvue";
import { getThemeStore, localDevAccountId } from "../../features/AppContext";
import { SyncQueue } from "../../storage/SyncQueue";
import {
  getStorageValue,
  setStorageValue,
} from "../../platform/ThemeEnvAdapter";
import { ResolvedTheme } from "../../theme/ThemeTypes";

export default {
  components: { AppButton, AppDialog },
  data() {
    return {
      theme: getThemeStore().getTheme() as ResolvedTheme | null,
      confirmOpen: false,
      pendingCount: 0,
    };
  },
  onShow() {
    this.theme = getThemeStore().getTheme();
    const queue = new SyncQueue(localDevAccountId,
        (key: string): string | null => getStorageValue(key),
        (key: string, value: string): void => setStorageValue(key, value));
    queue.load();
    this.pendingCount = queue.pendingCount();
  },
  computed: {
    pageStyle(): string {
      const t = this.theme;
      return t == null ? "" : "background-color:" + t.surface.page + ";";
    },
    titleStyle(): string {
      const t = this.theme;
      return t == null ? "" : "color:" + t.text.primary + ";";
    },
    hintStyle(): string {
      const t = this.theme;
      return t == null ? "" : "color:" + t.text.tertiary + ";font-size:14px;";
    },
    eyebrowStyle(): string {
      const t = this.theme;
      return t == null ? "" : "color:" + t.text.secondary +
          ";font-size:12px;letter-spacing:0.12em;";
    },
    cardStyle(): string {
      const t = this.theme;
      return t == null ? "" : "background-color:" + t.surface.card +
          ";border-color:" + t.border + ";box-shadow:0 10px 28px rgba(20,36,59,0.10);";
    },
    bodyStyle(): string {
      const t = this.theme;
      return t == null ? "" : "color:" + t.text.primary + ";font-size:17px;";
    },
  },
  methods: {
    onNewLesson(): void {
      this.confirmOpen = true;
    },
    onConfirmNewLesson(): void {
      this.confirmOpen = false;
      uni.navigateTo({ url: "/pages/practice/PracticePage?dayMode=new" });
    },
    onCancelConfirm(): void {
      this.confirmOpen = false;
    },
    onReview(): void {
      uni.navigateTo({ url: "/pages/practice/PracticePage?dayMode=review" });
    },
    onUnknown(): void {
      uni.navigateTo({ url: "/pages/practice/PracticePage?dayMode=unknown" });
    },
  },
};
</script>

<style>
.page {
  flex: 1;
  padding: 20px 18px 28px;
  overflow-y: auto;
}

.head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18px;
}
.eyebrow {
  font-size: 12px;
}
.eyebrow-note {
  font-size: 12px;
}
.title {
  font-size: 32px;
  font-weight: 600;
  letter-spacing: -0.4px;
  margin-bottom: 16px;
}
.hero-card {
  padding: 20px;
  border-radius: 22px;
  border-width: 1px;
  border-style: solid;
  margin-bottom: 18px;
}
.hero-kicker {
  font-size: 12px;
  margin-bottom: 8px;
}
.hero-title {
  font-size: 22px;
  margin-bottom: 6px;
}
.hero-body {
  font-size: 14px;
  line-height: 1.6;
  margin-bottom: 16px;
}
.hero-art {
  align-items: center;
  margin: 8px 0 18px;
}
.hero-tank {
  width: 190px;
  height: 96px;
}
.section-label {
  font-size: 12px;
  margin: 4px 0 10px;
}
.hint {
  font-size: 14px;
  margin-top: 16px;
}
</style>
